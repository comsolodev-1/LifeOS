# Neon pooled connection string (Neon dashboard > Connect > pooled)
DATABASE_URL=
# Random string: run `openssl rand -base64 32`
AUTH_SECRET=
# Use Google, GitHub, or both
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The only email allowed to sign in
OWNER_EMAIL=
# Public URL of the deployment (e.g. https://lifeos.vercel.app)
NEXT_PUBLIC_APP_URL=
# Gemini key from Google AI Studio (used from Sprint 1b, only through the Privacy Gateway)
GEMINI_API_KEY=
# Random 32-byte base64 string for Vault encryption (Sprint 1b). Back it up; losing it makes Vault entries unreadable.
VAULT_KEY=
